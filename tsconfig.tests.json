{
  "$schema": "https://json.schemastore.org/tsconfig",

  /*
   * A type-check target for the tests this milestone touched, and only those.
   *
   * `apps/web/tsconfig.json` includes `src/**` and nothing else, so no test file
   * has ever been type-checked. That is how `telemetrySubject(USER)` kept
   * passing after the function grew a second parameter: JavaScript filled the
   * tenant with `undefined`, every assertion still held, and the suite happily
   * proved that a subject derived from nothing is stable.
   *
   * Turning the whole test tree on surfaces 39 errors across four files, almost
   * all of them pre-existing looseness — partial `ProcessEnv` literals, a
   * `FakeModel` cast, a viewer role narrowed to one tenant. Repairing those is
   * real work and none of it is this change, so this target is deliberately
   * narrow: the files this milestone edited, checked under exactly the same
   * strictness as the source they exercise.
   *
   * **It is meant to grow.** Every file added here is one that can no longer
   * drift from the code it tests. Adding the rest is a milestone of its own.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": { "@/*": ["./apps/web/src/*"] },
    /*
     * The composition root now reaches a `.tsx` module through the catalogue
     * source (`control-plane.ts` imports a mark tone type from `StatusMark`),
     * and TypeScript refuses to resolve one at all without a JSX setting —
     * even for a type-only import. Preserve, because nothing here emits.
     */
    "jsx": "preserve"
  },
  "include": [
    "apps/web/test/ai-audit.test.ts",
    "apps/web/test/ai-config.test.ts",
    "apps/web/test/session-secret.test.ts",
    "supabase/test/audit-contract.test.ts",
    "supabase/test/cron-health.test.ts",
    "supabase/test/http-proof.test.ts",
    "supabase/test/ai-readiness.test.ts",
    "supabase/test/rollout-order.test.ts",
    "supabase/test/contract-readiness.test.ts",
    "supabase/test/no-secret-recipes.test.ts",
    "supabase/test/contract-policy.test.ts",
    "supabase/test/artefact-consistency.test.ts",
    "supabase/test/package-generation.test.ts",
    "supabase/test/project-mapping.test.ts",
    "supabase/test/supabase-resolver.test.ts",
    "supabase/test/gate-runner.test.ts",
    "supabase/test/gate-contract.test.ts",
    "supabase/test/control-chars.test.ts",

    /*
     * THE RELEASE SUITES, ADDED BECAUSE THE GAP WAS REAL.
     *
     * `release-operation.test.ts` was not in this list, so a test file that
     * called an undefined `gitAsync` nine times type-checked clean and would
     * have failed only when the case ran. These four exercise the release
     * apparatus itself, which is the part of this repository whose whole job is
     * refusing to describe something it has not measured.
     */
    "supabase/test/release-operation.test.ts",
    "supabase/test/gate-evidence.test.ts",
    "supabase/test/staged-module.test.ts",
    "supabase/test/worker-bound.test.ts",
    "supabase/test/terminal-phase.test.ts",
    "supabase/test/crash-recovery.test.ts",
    "apps/web/test/request-id-header.test.ts",

    /*
     * THE INGESTION SPINE.
     *
     * A grants suite is exactly the kind of file that must not drift: it asks
     * PostgreSQL who can do what, and every one of its assertions is a string —
     * a role name, a function signature, a privilege. A typo in a signature
     * makes `regprocedure` throw at run time rather than at check time, and a
     * typo in a table name makes `has_table_privilege` answer about nothing at
     * all while the test goes green.
     */
    "supabase/test/source-spine-grants.test.ts",
    "supabase/test/activation-credential.test.ts",
    "supabase/test/analytics-events.test.ts",

    /*
     * THE PRODUCT DESIGN SYSTEM.
     *
     * Added for the same reason the grants suite was: almost every assertion in
     * it is a string read out of a stylesheet — a token name, a selector, a
     * colour — and it computes contrast ratios from those strings. A typo in a
     * selector makes the helper return an empty block, and an empty block
     * satisfies every `not.toContain` in the file while measuring nothing.
     * Checking it means the helpers themselves cannot silently take `undefined`.
     */
    "apps/web/test/observer-product-design.test.ts",

    /*
     * THE CATALOGUE AND THE CONNECTORS (ADR-0036).
     *
     * The migration suite asks PostgreSQL about grants by signature string,
     * and the service suite feeds a fake CRM through the real sealing path —
     * both are the shape of test this list exists for.
     */
    "supabase/test/catalogue-connectors.test.ts",
    "supabase/test/deals-connectors.test.ts",
    "supabase/test/m10-migration-readiness.test.ts",
    "apps/web/test/connectors.test.ts",
    "apps/web/test/unit-register-sparse.test.ts",

    /*
     * WHO MAY READ A PROJECT'S EVENTS (ADR-0038).
     *
     * A grants suite like the ones above: every assertion names a function by
     * its signature string and a role by its name, and a typo in either makes
     * PostgreSQL answer about nothing while the test goes green.
     */
    "supabase/test/events-for-project.test.ts",

    /*
     * THE PROJECT DIRECTORY (docs/21-self-served-projects.md).
     *
     * The same kind of suite, over eleven doors and one table that holds people's
     * names. A signature string with one wrong type asks PostgreSQL about a
     * function that does not exist, and `has_function_privilege` raises rather
     * than answering false, so the strings are worth a strict compile.
     */
    "supabase/test/project-directory.test.ts",

    /*
     * THE ARTICLE 50 TRIPWIRE (docs/11-preproduction-gates.md, Gate 1).
     *
     * It walks the source tree and matches strings in it. A wrong directory makes
     * it scan nothing and pass, so the paths it builds are worth a strict check.
     */
    "apps/web/test/ai-notice-tripwire.test.ts",

    /*
     * THE ACCESS MATRIX AND THE TABLE IT READS.
     *
     * Both, because the table's whole value is that its cells are typed against
     * the functions they describe: a `MatrixRole` that stopped being a role, or
     * an outcome name the resolver no longer returns, has to fail here rather
     * than pass as a string. `test-support/access-matrix.ts` imports nothing and
     * belongs to no workspace package, so this is the only target that checks
     * it at all.
     */
    "apps/web/test/access-matrix.test.ts",
    "test-support/access-matrix.ts"
  ]
}
