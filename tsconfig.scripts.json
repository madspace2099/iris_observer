{
  "$schema": "https://json.schemastore.org/tsconfig",

  /*
   * The release tooling, checked under the same strictness as the source.
   *
   * It is TypeScript rather than plain `.mjs` for one reason: the secret-recipe
   * detector and the facts resolver are used by BOTH the packager and the test
   * suite, and a shared module that only one of the two can type-check is a
   * shared module that will drift.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["scripts/release/**/*.ts", "scripts/contracts/**/*.ts"]
}
