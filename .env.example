# ---------------------------------------------------------------------------
# IRIS Observer - environment
#
# Copy to .env.local. Only variables the code actually reads are listed here.
# No production credentials belong in this repository, ever.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (staging).
#
# The current key model, not the legacy anon / service_role pair. A new project
# gets a publishable key and a secret key, and the names say which is which —
# which the old names did not.
#
# The publishable key is safe in the browser ONLY because row-level security
# protects every table; see packages/db/sql.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never NEXT_PUBLIC_, never in a UE5 client, never logged.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used by drizzle-kit migrations and by seeds.
DATABASE_URL=

# Pepper for hashing device ingest credentials before storage.
# Generate with: node -e "console.log(crypto.randomUUID())"
DEVICE_CREDENTIAL_PEPPER=

# ---------------------------------------------------------------------------
# Ask Observer - the OpenAI intelligence layer (ADR-0026, ADR-0027)
#
# The key is server-only. Never prefix it with NEXT_PUBLIC_: a key in the
# browser bundle is a key anyone can read. Tests fail the build if any client
# component reads one, and `pnpm audit:secrets` scans the built bundle for the
# value itself.
#
# NEVER put a real key in this file. It is committed. Values belong in
# .env.local (gitignored) or in the platform's own secret store.
#
# Leave OPENAI_API_KEY empty to run evidence-only: the same tools, the same
# figures, the tools' own plainer prose, no network call and no cost. That is a
# supported mode, not a degraded one, and the answer sheet says which produced
# the wording.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Which model does what (ADR-0027)
#
# Model identifiers are configuration, not secrets, so their real values live
# here. Observer never silently substitutes one for another: a model this
# account cannot reach is a configuration error that says so, not a quiet
# downgrade to something cheaper.
#
#   Sol   primary intelligence. Every reader-facing answer, every comparison.
#   Luna  the fast path. Tool selection only - a turn whose output is checked
#         against a compile-time allowlist and a Zod schema before it can do
#         anything, and which no reader ever sees.
#   Voice the realtime layer. Reached only through an ephemeral client secret
#         minted server-side; the key above never enters a browser.
#
# OPENAI_REASONING_EFFORT is the default for ordinary questions. Deep reports
# request `high` explicitly, per question, from the interface - so cost is a
# decision somebody made rather than a function of how a question was phrased.
#
# OPENAI_STORE_RESPONSES is recorded for auditability and is ignored: the
# provider pins store=false on every request. Setting it true changes nothing.
# ---------------------------------------------------------------------------
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_VOICE_MODEL=gpt-realtime-2.1
OPENAI_REASONING_EFFORT=medium
OPENAI_STORE_RESPONSES=false
OBSERVER_AI_ENABLED=true
OBSERVER_VOICE_ENABLED=true

# ---------------------------------------------------------------------------
# Cost and abuse ceilings for the demonstration (ADR-0026)
#
# All optional; the defaults in apps/web/src/lib/ai/limits.ts are what a public
# demo can survive being found by a crawler. These are per-instance counters -
# a real global spend cap is the spending limit set on the OpenAI project, and
# both are required.
#
# OBSERVER_ALLOWED_MODELS is authorisation, not configuration: it decides which
# identifiers this deployment will call at all, so somebody who can set
# OPENAI_TEXT_MODEL cannot thereby point a public demo at the most expensive
# model on the account.
# ---------------------------------------------------------------------------
OBSERVER_MAX_QUESTION_CHARS=
OBSERVER_MAX_OUTPUT_TOKENS=
OBSERVER_MAX_TOOL_CALLS=
OBSERVER_LLM_TIMEOUT_MS=
OBSERVER_ASK_PER_MINUTE=
OBSERVER_ASK_PER_VIEWER_PER_DAY=
OBSERVER_ASK_PER_INSTANCE_PER_DAY=

# The shared ceilings, counted in Postgres rather than in a lambda's memory.
# These are the ones that actually bound the bill; the three above are a
# per-instance brake. Defaults: 60, 120, 500.
OBSERVER_ASK_PER_HOUR=
OBSERVER_ASK_CLIENT_PER_HOUR=
OBSERVER_ASK_PROJECT_PER_DAY=
OBSERVER_BREAKER_THRESHOLD=
OBSERVER_BREAKER_COOLDOWN_MS=
OBSERVER_ALLOWED_MODELS=

# ---------------------------------------------------------------------------
# Runtime posture
#
# Observer runs on the deterministic synthetic repository. Supabase is being
# provisioned as staging infrastructure for later milestones — authentication,
# canonical observations, projections, tenant isolation and RLS — and the
# application does not read from it yet.
#
# OBSERVER_DATA_SOURCE must stay "synthetic" until a milestone changes it
# deliberately. Pointing a finished UI at an empty database is not a migration.
# ---------------------------------------------------------------------------
OBSERVER_DATA_SOURCE=synthetic
OBSERVER_ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# The pseudonym key. REQUIRED. There is no fallback.
#
# Every rate-limit subject and client fingerprint is an HMAC under this key. A
# deployment without it refuses every question at the gate - before the quota is
# consulted, before an audit row is written, before any model is called - and
# says so by name in the boot line.
#
# It is not derived from SUPABASE_SECRET_KEY or any other credential, and that
# is deliberate. A derived key means rotating an unrelated secret silently
# changes every subject, orphans every rate-limit bucket and restarts all four
# ceilings from zero, mid-day, with nothing in any log.
#
# At least 32 bytes of cryptographically random material. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
#
# Rejected: empty, whitespace, anything under 32 bytes, values wrapped in quotes
# or brackets, obvious placeholders, and values repeating too few distinct
# characters. The same value must be set on every environment that shares a
# database, or the ceilings will not aggregate between them.
#
# Rotating it changes every pseudonymous identifier and resets subject-scoped
# quota buckets. It is a maintenance operation - see docs/18-deployment.md 11.
#
# NEVER put a real value in this file. It is committed.
# ---------------------------------------------------------------------------
OBSERVER_SUBJECT_PEPPER=
