# ---------------------------------------------------------------------------
# IRIS Observer - environment
#
# Copy to .env.local. Only variables the code actually reads are listed here.
# No production credentials belong in this repository, ever.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (staging).
#
# The current key model, not the legacy anon / service_role pair. A new project
# gets a publishable key and a secret key, and the names say which is which —
# which the old names did not.
#
# The publishable key is safe in the browser ONLY because row-level security
# protects every table; see packages/db/sql.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never NEXT_PUBLIC_, never in a UE5 client, never logged.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used by drizzle-kit migrations and by seeds.
DATABASE_URL=

# Pepper for hashing device ingest credentials before storage.
# Generate with: node -e "console.log(crypto.randomUUID())"
DEVICE_CREDENTIAL_PEPPER=

# ---------------------------------------------------------------------------
# Ask Observer - the language model (ADR-0024)
#
# Server-only. Never prefix with NEXT_PUBLIC_: a key in the browser bundle is a
# key anyone can read. A test fails the build if any client component reads it.
#
# Leave FAL_KEY empty to run the deterministic provider: the same tools, the
# same evidence, plainer prose, no network call and no cost.
# ---------------------------------------------------------------------------
FAL_KEY=
OBSERVER_LLM_PROVIDER=fal-openrouter
OBSERVER_LLM_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Runtime posture
#
# Observer runs on the deterministic synthetic repository. Supabase is being
# provisioned as staging infrastructure for later milestones — authentication,
# canonical observations, projections, tenant isolation and RLS — and the
# application does not read from it yet.
#
# OBSERVER_DATA_SOURCE must stay "synthetic" until a milestone changes it
# deliberately. Pointing a finished UI at an empty database is not a migration.
# ---------------------------------------------------------------------------
OBSERVER_DATA_SOURCE=synthetic
OBSERVER_ENVIRONMENT=staging
