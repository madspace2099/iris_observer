{
  "name": "iris-observer",
  "version": "0.1.0",
  "private": true,
  "description": "IRIS Observer - multi-tenant sales intelligence platform for MADSPACE IRIS showroom installations.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --filter @observer/web dev",
    "build": "pnpm --filter @observer/web build",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "matrix": "tsx packages/metrics/src/generate/cli.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
