node_modules/
.next/
dist/
out/
coverage/
*.tsbuildinfo

# Secrets. Only .env.example is committed.
.env
.env.local
.env*.local

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Test artefacts
playwright-report/
test-results/
.pglite/

.DS_Store
Thumbs.db

# Playwright visual output
screenshots/

# Review captures. docs/observer-visual-baseline.md states the policy — the
# repository has never carried baseline images and does not start now — but
# nothing enforced it, so a 48MB directory of generated PNGs was one `git add`
# away from the history. Preserved outside the working tree instead.
artifacts/

# Vercel CLI local state. Contains project and org identifiers written by the
# CLI, and is regenerated by `vercel link` — it never belongs in the repository.
.vercel

# Local machine configuration for connectors and agents. The project skill and
# the dev-server definition under .claude/ are tracked deliberately; anything
# ending in .local.json is this machine's own and is not.
.claude/settings.local.json
**/*.local.json

# Operator scratch: SQL for manual application, all of it generated by `pnpm release:wrappers`:
# paste wrappers of supabase/migrations, and verbatim copies of tracked verifiers,
# prerequisites and release evidence. The sources are version-controlled; these copies are
# not, so a fresh clone has none until that command runs.
_sql-to-paste/

# Independent-review bundles: generated from the repository, never part of it.
_review/

# Gate results, recorded by pnpm release:gates for the packager to render.
.release/

# Local control-plane database (dev only). Delete the directory to reset.
.observer-local/

# The Impeccable skill's live-mode state and critique snapshots: agent tooling
# beside the code, written by whichever session has live mode open. Not source,
# and the release packager refuses a tree that is not clean.
.impeccable/
**/.impeccable/

# Generated by Next (`writeAppTypeDeclarations`, run from `next typegen`, `next build`
# and `next dev`), and generated differently by each: build and typegen import
# `.next/types/*`, the dev server imports `.next/dev/types/*`. Both are valid, and
# tracking one made every dev-server start a dirty tree — the release packager
# refuses a dirty tree, and each lab run of the browser suite rewrote it.
apps/web/next-env.d.ts
