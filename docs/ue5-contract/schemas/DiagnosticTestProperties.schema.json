{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observer.madspace.dev/ue5/1.0.0-candidate.1/DiagnosticTestProperties.schema.json",
  "title": "DiagnosticTestProperties",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "activation_check",
        "manual_check",
        "support_check"
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reason",
    "note"
  ],
  "additionalProperties": false
}
