{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observer.madspace.dev/ue5/1.0.0-candidate.1/RequestFailureBody.schema.json",
  "title": "RequestFailureBody",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "malformed_request",
        "unauthorised",
        "source_suspended",
        "batch_too_large",
        "rate_limited",
        "unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "batch_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_after_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "code",
    "message",
    "batch_id",
    "retry_after_seconds"
  ],
  "additionalProperties": false
}
