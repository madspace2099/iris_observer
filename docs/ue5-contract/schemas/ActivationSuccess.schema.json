{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observer.madspace.dev/ue5/1.0.0-candidate.1/ActivationSuccess.schema.json",
  "title": "ActivationSuccess",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "activated",
        "reactivated"
      ]
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development",
        "demo"
      ]
    },
    "environment_mismatch": {
      "type": "boolean"
    },
    "source_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512
    },
    "token_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ingest_url": {
      "type": "string",
      "format": "uri"
    },
    "heartbeat_url": {
      "type": "string",
      "format": "uri"
    },
    "accepted_schema_versions": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_batch_events": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "max_batch_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 67108864
            },
            {
              "type": "null"
            }
          ]
        },
        "max_event_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 256,
              "maximum": 4194304
            },
            {
              "type": "null"
            }
          ]
        },
        "max_property_depth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "max_property_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "min_send_interval_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_batch_events",
        "max_batch_bytes",
        "max_event_bytes",
        "max_property_depth",
        "max_property_count",
        "min_send_interval_ms"
      ],
      "additionalProperties": false
    },
    "config_refresh_after": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "status",
    "source_id",
    "display_label",
    "environment",
    "environment_mismatch",
    "source_token",
    "token_expires_at",
    "ingest_url",
    "heartbeat_url",
    "accepted_schema_versions",
    "limits",
    "config_refresh_after"
  ],
  "additionalProperties": false
}
