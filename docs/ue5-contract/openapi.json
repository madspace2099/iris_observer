              "production",
              "staging",
              "development"
            ]
          },
          "installation_nonce": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "build": {
            "type": "object",
            "properties": {
              "app_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "plugin_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "build_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "engine_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "required": [
              "app_version",
              "plugin_version",
              "build_id",
              "engine_version"
            ],
            "additionalProperties": false
          },
          "os": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        },
        "required": [
          "activation_code",
          "reported_environment",
          "installation_nonce",
          "build",
          "os"
        ],
        "additionalProperties": false
      },
      "ActivationSuccess": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "activated",
              "reactivated"
            ]
          },
          "source_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
