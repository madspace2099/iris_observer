          }
        },
        "required": [
          "status",
          "source_id",
          "display_label",
          "environment",
          "environment_mismatch",
          "source_token",
          "token_expires_at",
          "ingest_url",
          "heartbeat_url",
          "accepted_schema_versions",
          "limits",
