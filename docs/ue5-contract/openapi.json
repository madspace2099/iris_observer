          "accepted_schema_versions": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            },
            "required": [
