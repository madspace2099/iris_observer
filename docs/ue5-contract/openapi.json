                  {
                    "type": "null"
                  }
                ]
              },
              "max_batch_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 67108864
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_event_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 256,
                    "maximum": 4194304
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_property_depth": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_property_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "min_send_interval_ms": {
                "anyOf": [
