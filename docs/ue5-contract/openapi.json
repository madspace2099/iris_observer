{
  "openapi": "3.1.0",
  "info": {
    "title": "IRIS Observer — UE5 ingestion contract",
    "version": "1.0.0-candidate.1",
    "summary": "Activation, batch ingestion and heartbeat for the IRIS UE5 plugin (PROPOSED).",
    "description": "**PROPOSED contract candidate. Not implemented; no endpoint exists.**\n\nThe one rule to read before any other:\n\n> The HTTP status says whether the batch was processed. It never says whether the events\n> were accepted.\n\n`200` means the batch was processed — consult the per-event `results`, even when every\nevent in it was rejected. Any non-2xx means the batch was **not** processed, nothing was\nstored, and the whole batch is safe to resend unchanged.\n\nTenant, project and source identity are derived by the server from the activated\ncredential. No request body carries them, and every envelope refuses them."
  },
  "servers": [
    {
      "url": "https://{projectRef}.supabase.co/functions/v1",
      "description": "Observer Edge Functions. The project reference is deployment-specific.",
      "variables": {
        "projectRef": {
          "default": "example"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "activation",
      "description": "One-time exchange of a code for a source credential."
    },
    {
      "name": "ingestion",
      "description": "Batched, idempotent, per-event analytics submission."
    },
    {
      "name": "diagnostics",
      "description": "Liveness, plugin health, and the end-to-end test event."
    }
  ],
  "paths": {
    "/observer-activate": {
      "post": {
        "tags": [
          "activation"
        ],
        "operationId": "activateSource",
        "summary": "Exchange a one-time activation code for a source credential",
        "description": "Unauthenticated. Unknown, expired and already-consumed codes answer an identical 401, so that nothing discloses whether a tenant, project or source exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activated or reactivated. The token is returned once, here, and never again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationSuccess"
                }
              }
            }
          },
          "400": {
            "description": "The request could not be parsed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationFailure"
                }
              }
            }
          },
          "401": {
            "description": "The code could not be used. Unknown, expired and consumed are indistinguishable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationFailure"
                }
              }
            }
          },
          "409": {
            "description": "This installation already has a live source. No token is issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationFailure"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationFailure"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationFailure"
                }
              }
            }
          }
        }
      }
    },
    "/observer-ingest": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "operationId": "ingestBatch",
        "summary": "Submit a batch of analytics events",
        "description": "Identity is derived from the credential. An empty batch is valid and returns `received: 0`; it is not a heartbeat.",
        "security": [
          {
            "sourceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The batch was processed. Consult the per-event results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "The batch envelope is malformed or carries a forbidden field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "401": {
            "description": "The credential is unknown, revoked or superseded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "403": {
            "description": "The credential is valid; the source is suspended or archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "413": {
            "description": "Over the batch ceiling in force. Split and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Retry-After is authoritative.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "503": {
            "description": "Nothing was stored. Retain and back off.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          }
        }
      }
    },
    "/observer-heartbeat": {
      "post": {
        "tags": [
          "diagnostics"
        ],
        "operationId": "heartbeat",
        "summary": "Report liveness and plugin health",
        "description": "Writes to the source's operational record and never to analytics_events. Carries queue depth, quarantine count and the last error code — the things an operator needs when a showroom looks quiet, none of which are facts about a customer.",
        "security": [
          {
            "sourceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatResponse"
                }
              }
            }
          },
          "401": {
            "description": "The credential is unknown, revoked or superseded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "403": {
            "description": "The source is suspended or archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestFailureBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sourceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The source credential from activation. Opaque: never parsed, decoded or logged. Scoped to appending events for one source, and able to read nothing."
      }
    },
    "schemas": {
      "ActivationRequest": {
        "type": "object",
        "properties": {
          "activation_code": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
