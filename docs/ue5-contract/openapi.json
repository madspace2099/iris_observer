              "max"
            ],
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "properties": {
              "max_batch_events": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
